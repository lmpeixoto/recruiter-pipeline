# Gmail OAuth
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json

# OpenRouter
OPENROUTER_API_KEY=sk-or-v1-...

# Notion
NOTION_TOKEN=secret_...
NOTION_PARENT_PAGE_ID=...

# Tavily (opcional — enriquecimento de empresas)
TAVILY_API_KEY=tvly-...

# Estado local
STATE_DB_PATH=state.db

# LLM
# Vê modelos disponíveis em https://openrouter.ai/models
OPENROUTER_MODEL=openai/gpt-4o-mini

# Opcional: liga o Jev (decisions model, via /api/alpha/decisions do
# OpenRouter) para is_opportunity, opportunity_type e recommended_action.
# O resto do pipeline fica no LLM normal. Ex.: typesafe/jev-1.13.
# Vazio = tudo no OPENROUTER_MODEL, como antes.
JEV_MODEL=
